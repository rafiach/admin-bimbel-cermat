generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  phoneNumber   Int?      @map("phone_number")
  bio           String?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}


model Siswa {
  id            String       @id @default(cuid())
  nama          String
  sekolah       String?
  kelas         String?
  noHpOrtu      String?      @map("no_hp_ortu")
  tanggalDaftar DateTime     @default(now()) @map("tanggal_daftar")
  notes         String?
  status        String       @default("aktif")
  kelasList     Kelas[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("siswa")
}

model Tutor {
  id        String   @id @default(cuid())
  nama      String
  noHp      String?  @map("no_hp")
  alamat    String?
  jenjang   String?
  status    String   @default("aktif")
  userId    String?  @unique @map("user_id")   // buat nyambung ke akun login nanti
  kelasList Kelas[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("tutor")
}

model Kelas {
  id         String     @id @default(cuid())
  siswaId    String     @map("siswa_id")
  siswa      Siswa      @relation(fields: [siswaId], references: [id])
  tutorId    String     @map("tutor_id")
  tutor      Tutor      @relation(fields: [tutorId], references: [id])
  tipe       String     @default("privat") // "privat" | "kelompok"
  jadwal     String     // teks bebas, misal: "Senin & Kamis, 15:00"
  biayaOrtu  Int        @map("biaya_ortu")  // per pertemuan, ditagih ke ortu
  feeTutor   Int        @map("fee_tutor")   // per pertemuan, dibayar ke tutor
  status     String     @default("aktif")
  presensi   Presensi[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("kelas")
}

model Presensi {
  id        String   @id @default(cuid())
  kelasId   String   @map("kelas_id")
  kelas     Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  tanggal   DateTime
  hadir     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("presensi")
}