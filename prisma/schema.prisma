generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  phoneNumber   Int?      @map("phone_number")
  bio           String?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}


model Siswa {
  id            String       @id @default(cuid())
  nama          String
  alamat        String?      @map("alamat")
  sekolah       String?
  kelas         String?
  namaOrtu      String?      @map("nama_ortu")
  noHpOrtu      String?      @map("no_hp_ortu")
  tanggalDaftar DateTime     @default(now()) @map("tanggal_daftar")
  notes         String?
  biayaBimbel   Int?         @map("biaya_bimbel")
  status        String       @default("aktif")
  kelasList     Kelas[]
  anggotaKelompok        AnggotaKelompok[]
  anggotalaporanKelompok AnggotaLaporanKelompok[]
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("siswa")
}

model Tutor {
  id         String   @id @default(cuid())
  nama       String
  alamat     String?
  jenjang    String?
  noHp       String?  @map("no_hp")
  status     String   @default("aktif")
  userId     String?  @unique @map("user_id")
  kelasList      Kelas[]
  kalompok   Kelompok[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("tutor")
}

model Kelas {
  id         String     @id @default(cuid())
  siswaId    String     @map("siswa_id")
  siswa      Siswa      @relation(fields: [siswaId], references: [id])
  tutorId    String     @map("tutor_id")
  tutor      Tutor      @relation(fields: [tutorId], references: [id])
  tipe       String     @default("privat") // "privat" | "kelompok"
  jadwal     String     // teks bebas, misal: "Senin & Kamis, 15:00"
  biayaOrtu  Int        @map("biaya_ortu")  // per pertemuan, ditagih ke ortu
  feeTutor   Int        @map("fee_tutor")   // per pertemuan, dibayar ke tutor
  status     String     @default("aktif")
  laporan    LaporanBulanan[]
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")

  @@map("kelas")
}

model LaporanBulanan {
  id               String   @id @default(cuid())
  kelasId          String   @map("kelas_id")
  kelas            Kelas    @relation(fields: [kelasId], references: [id], onDelete: Cascade)
  bulan            Int
  tahun            Int
  jumlahHadir      Int      @map("jumlah_hadir")
  jumlahIzin       Int      @default(0) @map("jumlah_izin")
  norekTutor       String?  @map("norek_tutor")
  materiDipelajari String?  @map("materi_dipelajari")
  pemahamanMateri  Int      @map("pemahaman_materi")   // 1-5
  keaktifanBelajar Int      @map("keaktifan_belajar")  // 1-5
  kemandirian      Int      @map("kemandirian")        // 1-5
  kedisiplinan     Int      @map("kedisiplinan")       // 1-5
  catatanSiswa     String?  @map("catatan_siswa")
  saranBimbel      String?  @map("saran_bimbel")
  statusBayarOrtu  String   @default("belum") @map("status_bayar_ortu")
  statusBayarTutor String   @default("belum") @map("status_bayar_tutor")
  createdAt        DateTime @default(now()) @map("created_at")

  @@unique([kelasId, bulan, tahun])
  @@map("laporan_bulanan")
}

model Kelompok {
  id                String            @id @default(cuid())
  nama              String
  tutorId           String            @map("tutor_id")
  tutor             Tutor             @relation(fields: [tutorId], references: [id])
  jadwal            String
  hargaKelompok     Int               @map("harga_kelompok")
  feeTutorKelompok  Int               @map("fee_tutor_kelompok")
  namaWali          String?           @map("nama_wali")
  noHpWali          String?           @map("no_hp_wali")
  status            String            @default("aktif")
  anggota           AnggotaKelompok[]
  laporan           LaporanKelompok[]
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  @@map("kelompok")
}

model AnggotaKelompok {
  id          String   @id @default(cuid())
  kelompokId  String   @map("kelompok_id")
  kelompok    Kelompok @relation(fields: [kelompokId], references: [id], onDelete: Cascade)
  siswaId     String   @map("siswa_id")
  siswa       Siswa    @relation(fields: [siswaId], references: [id])
  hargaPrivat Int      @map("harga_privat")
  feeTutor    Int      @map("fee_tutor")

  @@unique([kelompokId, siswaId])
  @@map("anggota_kelompok")
}

model LaporanKelompok {
  id                 String                   @id @default(cuid())
  kelompokId         String                   @map("kelompok_id")
  kelompok           Kelompok                 @relation(fields: [kelompokId], references: [id], onDelete: Cascade)
  bulan              Int
  tahun              Int
  jumlahKelompok     Int                      @map("jumlah_kelompok")
  jumlahIzin         Int                      @default(0) @map("jumlah_izin")
  hargaKelompokFinal Int?                     @map("harga_kelompok_final")
  materiDipelajari   String?                  @map("materi_dipelajari")
  pemahamanMateri    Int                      @map("pemahaman_materi")
  keaktifanBelajar   Int                      @map("keaktifan_belajar")
  kemandirian        Int
  kedisiplinan       Int
  catatanSiswa       String?                  @map("catatan_siswa")
  saranBimbel        String?                  @map("saran_bimbel")
  norekTutor         String?                  @map("norek_tutor")
  statusBayarOrtu    String                   @default("belum") @map("status_bayar_ortu")
  statusBayarTutor   String                   @default("belum") @map("status_bayar_tutor")
  anggotaLaporan     AnggotaLaporanKelompok[]
  createdAt          DateTime                 @default(now()) @map("created_at")

  @@unique([kelompokId, bulan, tahun])
  @@map("laporan_kelompok")
}

model AnggotaLaporanKelompok {
  id                String          @id @default(cuid())
  laporanKelompokId String          @map("laporan_kelompok_id")
  laporanKelompok   LaporanKelompok @relation(fields: [laporanKelompokId], references: [id], onDelete: Cascade)
  siswaId           String          @map("siswa_id")
  siswa             Siswa           @relation(fields: [siswaId], references: [id])
  jumlahIndividu    Int             @default(0) @map("jumlah_individu")

  @@unique([laporanKelompokId, siswaId])
  @@map("anggota_laporan_kelompok")
}